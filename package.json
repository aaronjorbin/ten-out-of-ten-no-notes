{
	"name": "ten-out-of-ten-no-notes",
	"version": "1.1.0",
	"description": "Disables the ability to add Notes, the block editor feature added in WordPress 6.9.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@wordpress/e2e-test-utils-playwright": "2.0.0",
		"@wordpress/env": "11.15.0"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:cli": "wp-env run cli wp",
		"test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/ten-out-of-ten-no-notes vendor/bin/phpunit -c phpunit-integration.xml.dist",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	}
}
